rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só acessa seus próprios dados
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Acesso manual (Android, sem Play Billing): cada usuário só lê o próprio
    // status; só o e-mail admin pode conceder/revogar (escrita).
    match /acessosManuais/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email == email || request.auth.token.email == 'erick@icloud.com');
      allow write: if request.auth != null && request.auth.token.email == 'erick@icloud.com';
    }
  }
}
